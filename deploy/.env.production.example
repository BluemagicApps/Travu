# Travu production env — copy to `.env` on the VPS (NEVER commit the real file).
#   cp deploy/.env.production.example .env   then fill in real values.

# --- App ---
NODE_ENV=production
# Public site URL (used by next-auth + canonical/OG)
AUTH_URL=https://travunow.com

# --- Database (local Postgres on the VPS) ---
# Format: postgresql://USER:PASSWORD@localhost:5432/DBNAME
# Migrations use DIRECT_URL; app runtime uses DATABASE_URL. With a local
# (non-pooled) Postgres they are the same connection string.
DATABASE_URL=postgresql://travu:CHANGE_ME_STRONG_PW@localhost:5432/travu
DIRECT_URL=postgresql://travu:CHANGE_ME_STRONG_PW@localhost:5432/travu

# --- Auth (generate a fresh secret on the VPS: `openssl rand -base64 32`) ---
AUTH_SECRET=CHANGE_ME_RUN_openssl_rand_base64_32

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# --- Duffel (flights live; stays still 403 until the account is enabled) ---
DUFFEL_API_TOKEN=duffel_test_CHANGE_ME
DUFFEL_VERSION=v2

# --- Amadeus (optional; blank = mock flight provider) ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
